; Uniforms
.fvec projection[4], model[4], view[4]

; Constants
.constf const(0.0, 1.0, -1.0, 0.5)
.alias  zeros const.xxxx
.alias  ones  const.yyyy
.alias  half  const.wwww

; Inputs
.alias inPos v0
.alias inTex v1
.alias inNor v2

; Outputs
.out outPos  position
.out outTc0  texcoord0
.out outCol  color
.out outView view
.out outNq   normalquat

.proc main
    mov r0.xyz, inPos.xyz
    mov r0.w, const.y ; w is always 1.0 for position

    ; r1 = world-space position (model * r0)
    dp4 r1.x, model[0], r0
    dp4 r1.y, model[1], r0
    dp4 r1.z, model[2], r0
    dp4 r1.w, model[3], r0

    ; r2 = view-space position (view * r1)
    dp4 r2.x, view[0], r1
    dp4 r2.y, view[1], r1
    dp4 r2.z, view[2], r1
    dp4 r2.w, view[3], r1

    mov outView, -r2

    ; output = clip-space position (projection * r2)
    dp4 outPos.x, projection[0], r2
    dp4 outPos.y, projection[1], r2
    dp4 outPos.z, projection[2], r2
    dp4 outPos.w, projection[3], r2

    mov outTc0, inTex

    ; Transform the normal vector with the model matrix
    ; TODO: use a separate normal matrix that is the transpose of the inverse of modelView

    ; r0 = world-space normal
    dp3 r0.x, model[0], inNor
    dp3 r0.y, model[1], inNor
    dp3 r0.z, model[2], inNor

    ; r1.x = 1 / sqrt((length of normal)^2)
    dp3 r1.x, r0, r0
    rsq r1.x, r1.x

    ; r0 = normalized normal (normal * (1 / length of normal))
    mul r0.xyz, r0.xyz, r1.x

    mov r1, const.yxxx      ; r1 = (1,0,0,0)
    add r2, ones, r0.z      ; r2 = 1 + normal.z
    mul r2, half, r2        ; r2 = 0.5 * (1 + normal.z)
    cmp zeros, ge, ge, r2.x ; cmp.x = (0 >= 0.5 * (1 + normal.z))
    rsq r2, r2.x            ; r2 = 1 / sqrt(0.5 * (1 + normal.z))
    mul r3, half, r0        ; r3 = 0.5 * normal
    jmpc cmp.x, degenerate  ; if cmp.x, go to degenerate

    rcp r1.z, r2.x          ; r1.z = sqrt(0.5 * (1 + normal.z))
    mul r1.xy, r3, r2       ; r1.xy = 0.5 * normal / sqrt(0.5 * (1 + normal.z))

degenerate:
    mov outNq, r1
    mov outCol, ones

    end
.end